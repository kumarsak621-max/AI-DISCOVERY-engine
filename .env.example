# Required for AI analysis of collected conversations
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Gemini (Generative Language API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: openrouter | gemini for scheduler jobs
AI_PROVIDER=openrouter

# Reddit — optional OAuth. Public JSON search is used if unset.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=myntra-discovery-engine/1.0

# YouTube Data API v3 — required for YouTube comments
YOUTUBE_API_KEY=

# Apify — public Reddit collection platform (not the official Reddit API)
APIFY_API_TOKEN=
APIFY_REDDIT_ACTOR_ID=
# Optional comma-separated public subreddit names. Set to - to skip subreddit crawls.
# APIFY_REDDIT_SUBREDDITS=India,IndianFashionAddicts,IndiaShopping

# Store identifiers
PLAY_STORE_APP_ID=com.myntra.android
APP_STORE_APP_ID=907394059
APP_STORE_COUNTRY=in

# Optional: protect HTTP / query-param collection triggers
CRON_SECRET=
CRON_PORT=8080

DATABASE_PATH=data/discovery.db
LOG_LEVEL=INFO

# Set to 1 to skip first-run auto-collection (useful for local UI smoke tests)
SKIP_AUTO_COLLECTION=
